{
    "manifest_version": 3,
    "name": "GitBlame Explainer",
    "version": "1.0",
    "description": "Hover any GitHub code line to see who wrote it and get an AI explanation.",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    }
}